{
  "name": "@headroom/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "setup": "bun scripts/setup-open-wearables.ts",
    "persona:generate": "bun scripts/generate-persona.ts",
    "db:reset": "bun scripts/reset-db.ts",
    "openapi:types": "openapi-typescript ../../../open-wearables/docs/openapi.json -o src/open-wearables/generated/openapi.d.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "drizzle-orm": "^0.45.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "svix": "^2.6.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2"
  }
}
